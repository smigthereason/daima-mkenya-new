{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "./dist-scripts",
    "rootDir": "./scripts",
    "resolveJsonModule": true,
  },
  "include": ["scripts/**/*"],
  "exclude": ["node_modules"],
}
